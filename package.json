{
  "name": "crm-seller",
  "version": "0.8.12",
  "description": "CRM local para pedidos personalizados (Shopee)",
  "main": "out/main/index.js",
  "author": "Filipe Peixoto <filipenos@gmail.com>",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "dev:linux": "ELECTRON_DISABLE_SANDBOX=1 electron-vite dev",
    "build": "electron-vite build",
    "build:web": "vite build --config vite.web.config.ts && tsc --noEmit -p tsconfig.worker.json",
    "dev:web": "npm run build:web && wrangler dev",
    "deploy:web": "node scripts/deploy-web.mjs",
    "typecheck": "npm run check:db-access && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test:composition": "esbuild scripts/check-composition.ts --bundle --platform=node --format=esm --packages=external --alias:@shared=./src/shared --alias:electron=./scripts/electron-test-stub.ts --outfile=node_modules/.cache/crm-seller-check-composition.mjs && NODE_ENV=test node node_modules/.cache/crm-seller-check-composition.mjs",
    "test:tabs": "esbuild scripts/check-order-tabs.ts --bundle --platform=node --format=esm --packages=external --alias:@shared=./src/shared --outfile=node_modules/.cache/crm-seller-check-order-tabs.mjs && node node_modules/.cache/crm-seller-check-order-tabs.mjs",
    "test:orders": "esbuild scripts/check-order-sync.ts --bundle --platform=node --format=esm --packages=external --alias:@shared=./src/shared --alias:electron=./scripts/electron-test-stub.ts --outfile=node_modules/.cache/crm-seller-check-order-sync.mjs && NODE_ENV=test node node_modules/.cache/crm-seller-check-order-sync.mjs",
    "test:dashboard": "esbuild scripts/check-dashboard.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/crm-seller-check-dashboard.mjs && node node_modules/.cache/crm-seller-check-dashboard.mjs",
    "test:report": "esbuild scripts/check-management-report.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/crm-seller-check-report.mjs && node node_modules/.cache/crm-seller-check-report.mjs",
    "test:tracking": "esbuild scripts/check-tracking-history.ts --bundle --platform=node --format=esm --packages=external --alias:@shared=./src/shared --alias:electron=./scripts/electron-test-stub.ts --outfile=node_modules/.cache/crm-seller-check-tracking.mjs && NODE_ENV=test node node_modules/.cache/crm-seller-check-tracking.mjs",
    "test:work": "esbuild scripts/check-work-agenda.ts --bundle --platform=node --format=esm --packages=external --alias:@shared=./src/shared --alias:electron=./scripts/electron-test-stub.ts --outfile=node_modules/.cache/crm-seller-check-work.mjs && NODE_ENV=test node node_modules/.cache/crm-seller-check-work.mjs",
    "test:art": "esbuild scripts/check-art-geometry.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/crm-seller-check-art.mjs && node node_modules/.cache/crm-seller-check-art.mjs",
    "test:settings": "esbuild scripts/check-local-settings.ts --bundle --platform=node --format=esm --packages=external --alias:@shared=./src/shared --alias:electron=./scripts/electron-settings-test-stub.ts --outfile=node_modules/.cache/crm-seller-check-settings.mjs && node node_modules/.cache/crm-seller-check-settings.mjs",
    "test:production": "esbuild scripts/check-production-flow.ts --bundle --platform=node --format=esm --packages=external --alias:@shared=./src/shared --alias:electron=./scripts/electron-test-stub.ts --outfile=node_modules/.cache/crm-seller-check-production.mjs && NODE_ENV=test node node_modules/.cache/crm-seller-check-production.mjs",
    "test:mcp": "esbuild scripts/check-mcp-access.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/crm-seller-check-mcp.mjs && node node_modules/.cache/crm-seller-check-mcp.mjs && esbuild scripts/check-chatgpt-mcp-install.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/crm-seller-check-mcp-install.mjs && node node_modules/.cache/crm-seller-check-mcp-install.mjs",
    "check:db-access": "node scripts/check-db-access.mjs",
    "postinstall": "electron-builder install-app-deps",
    "build:win": "electron-vite build && electron-builder --win",
    "build:win:preview": "node scripts/build-windows-preview.mjs",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "electron-updater": "^6.8.9",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "wrangler": "^4.134.0"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "electron@43.2.0": true,
    "workerd@1.20260917.1": true
  }
}
