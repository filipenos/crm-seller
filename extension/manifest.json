{
  "manifest_version": 3,
  "name": "CRM Seller — sessão Shopee",
  "description": "Compartilha a sessão Shopee do Chrome somente com o CRM Seller neste computador.",
  "version": "0.2.1",
  "key": "",
  "permissions": ["cookies", "alarms"],
  "host_permissions": ["https://*.shopee.com.br/*", "http://*.shopee.com.br/*", "http://127.0.0.1:17384/*"],
  "action": { "default_title": "CRM Seller — sessão Shopee", "default_popup": "popup.html" },
  "background": { "service_worker": "background.js" }
}
